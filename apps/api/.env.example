# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
API_PORT=4001
WEB_ORIGIN=http://localhost:3000
# Dedicated `aglotrends` Postgres role (port 5433). Separated from COPINEX.
DATABASE_URL=postgresql://aglotrends:CHANGE_ME@localhost:5433/aglotrends
JWT_SECRET=dev-only-secret-change-me
SESSION_TTL_HOURS=24
# Encrypts the gateway merchant token + webhook secret at rest in app_config.
# 32 bytes, base64 or hex. Generate: openssl rand -base64 32
# Blank = plaintext (dev only). Production refuses to boot without it.
SECRET_ENCRYPTION_KEY=
# Public base URL used to build outbound links (payment return_url etc.).
APP_URL=http://localhost:3000

# Notification channels — leave blank to disable (fan-out records SKIPPED, not FAILED)
# Format: smtp://user:password@host:587  or  smtps://user:password@host:465
# Malformed values are rejected at boot rather than failing silently at send.
SMTP_URL=
SMTP_FROM="Aglotrends <no-reply@aglotrends.com>"
SMTP_REPLY_TO=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
TELEGRAM_BOT_TOKEN=

# Pay2Crypto crypto rail (non-custodial, TRC20 USDT).
# Blank = MOCK mode: a synthetic checkout URL is issued, webhooks are simulated.
# Set all three for live operation; production refuses to boot without them.
PAY2CRYPTO_API_URL=
PAY2CRYPTO_TOKEN=
PAY2CRYPTO_WEBHOOK_SECRET=
