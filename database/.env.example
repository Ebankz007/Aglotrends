# Copy to .env and fill in. Never commit real secrets.
# The dev PostgreSQL instance listens on 5433, not the default 5432.
# Uses the dedicated `aglotrends` role — NOT the `copinex` role the two
# projects shared before the 2026-10-10 separation. See README (Database).
DATABASE_URL=postgresql://aglotrends:CHANGE_ME@localhost:5433/aglotrends
TEST_DATABASE_URL=postgresql://aglotrends:CHANGE_ME@localhost:5433/aglotrends_test

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-in-production
SESSION_TTL_HOURS=24

# Notification channels (leave blank to disable — the fan-out no-ops safely)
SMTP_URL=
SMTP_FROM="Aglotrends <no-reply@aglotrends.com>"
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
TELEGRAM_BOT_TOKEN=

# Pay2Crypto rail (crypto payments, non-custodial TRC20 USDT).
# Leave all three blank for MOCK mode: a synthetic checkout URL is issued so
# the flow is testable without a merchant token. All three required in prod.
PAY2CRYPTO_API_URL=
PAY2CRYPTO_TOKEN=
PAY2CRYPTO_WEBHOOK_SECRET=
